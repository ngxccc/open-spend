{
  "name": "open-spend-monorepo",
  "version": "1.0.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun --filter @open-spend/mobile start",
    "start:doppler": "doppler run -- bun --filter @open-spend/mobile start",
    "android": "bun --filter @open-spend/mobile android",
    "ios": "bun --filter @open-spend/mobile ios",
    "web": "bun --filter @open-spend/mobile web",
    "build": "bun --filter @open-spend/mobile build",
    "dev:server": "bun --filter @open-spend/server dev",
    "dev:server:doppler": "bun --filter @open-spend/server dev:doppler",
    "deploy:server": "bun --filter @open-spend/server deploy",
    "env:pull": "doppler secrets download --no-file --format env > apps/server/.env && doppler secrets download --no-file --format env > apps/mobile/.env",
    "check": "bun run format && bun run lint && bun run typecheck",
    "format": "oxfmt --write",
    "lint": "oxlint --type-aware --fix",
    "typecheck": "bun --filter '*' typecheck",
    "test:e2e": "bun --filter @open-spend/mobile test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-config-presets": "^0.1.20",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "lightningcss": "1.30.1",
    "postcss-selector-parser": "^7.1.6",
    "uuid": "^13.0.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
